---
import Base from '../layouts/Base.astro';
import KeyEvents from '../components/KeyEvents.astro';
import TimelineList from '../components/TimelineList.astro';
import events from '../../data/events.json';
import recruitmentEvents from '../../data/recruitment_events.json';
import type { TimelineEvent } from '../lib/types';
---

<Base
  title="6·3 투표용지 부족 사태 기록"
  description="6·3 지방선거 투표용지 부족 사태와 그 이전 선관위 채용 비리 배경 기록을 공식 발표·국회 문서·법원 결정 기준으로 날짜순 보관합니다."
  active="timeline"
>
  <section>
    <span class="eyebrow">6·3 사태 기록</span>
    <h1>날짜순 공식 기록</h1>
    <p class="lede" style="margin-bottom:14px">
      공식 문서 또는 복수 매체가 교차 확인한 사실만 수록합니다. 단독 보도·미확인 주장은
      싣지 않습니다. 정정된 발표는 삭제하지 않고 <span class="badge b-correct">↻ 정정됨</span>
      라벨과 함께 남기며, 변경 내역은 커밋 이력으로 공개됩니다.
    </p>
    <KeyEvents events={events as TimelineEvent[]} />
    <TimelineList events={events as TimelineEvent[]} />
  </section>

  <section>
    <span class="eyebrow">채용 비리 배경 기록</span>
    <h2>6·3 이전 선관위 채용·감사·수사 기록</h2>
    <p class="lede" style="margin-bottom:14px">
      6·3 사태 이전에 누적된 선관위 채용 비리 관련 공식 기록을 별도 보관합니다. 권익위
      고발 28명 전원 불기소와 별도 기소 사건이 병존하므로, 수사·재판 결과가 갈린 흐름을
      함께 남깁니다.
    </p>
    <TimelineList events={recruitmentEvents as TimelineEvent[]} />
  </section>

  <section>
    <span class="eyebrow">수록 기준</span>
    <p class="lede" style="font-size:14px">
      출처 등급 <span class="src official">공식문서</span>는 선관위·국회·관보·법원 발표,
      <span class="src press">복수 매체 교차</span>는 두 곳 이상의 매체가 동일 사실을 보도한
      경우입니다. 누락이 오염보다 낫다는 원칙으로, 확인되지 않은 항목은 싣지 않습니다.
    </p>
  </section>
</Base>
