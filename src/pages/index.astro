---
import Base from '../layouts/Base.astro';
import events from '../../data/events.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = [...events].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
---

<Base
  title="공식 기록으로 보는 삼권"
  description="선관위 구성, 6·3 사태 타임라인, 국정조사 진행 상황을 공식 원문 링크와 함께 기록합니다. 해석과 결론은 없습니다."
>
  <h1>삼권 三權</h1>
  <p>
    선거관리위원회·국회·법원에 관한 <strong>공식 기록 보관소</strong>입니다.
    모든 항목은 원문 링크를 가지며, 이 사이트는 어떤 판정도 하지 않습니다.
  </p>

  <ul>
    <li><a href={`${base}/election-commission/members`}>중앙선관위원 9인은 누가 임명했나</a> — 임명 주체별 구성 지도</li>
    <li><a href={`${base}/timeline`}>6·3 투표용지 부족 사태 기록</a> — 날짜순 공식 발표 타임라인</li>
    <li><a href={`${base}/inquiry`}>선관위 국정조사 추적</a> — 절차 단계·특위·증인 현황</li>
  </ul>

  <h2>최근 기록</h2>
  <ul class="timeline">
    {latest.map((evt) => (
      <li>
        <time datetime={evt.date}>{evt.date}</time>
        <p class="evt-title">{evt.title}</p>
      </li>
    ))}
  </ul>
</Base>
