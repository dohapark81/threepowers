---
import Base from '../../layouts/Base.astro';
import CompositionMap from '../../components/CompositionMap.astro';
import PartyHeatmap from '../../components/PartyHeatmap.astro';
import appointments from '../../../data/appointments.json';
import partyLineage from '../../../data/party_lineage.json';
import provincialCommissioners from '../../../data/provincial_commissioners.json';
import type { Appointment, PartyLineage, ProvincialCommissionersData } from '../../lib/types';
---

<Base
  title="중앙선거관리위원 9인은 누가 임명했나"
  description="중앙선거관리위원회 위원 9인의 임명 주체(대통령·국회·대법원장), 임명일, 임기, 경력을 공식 자료 원문 링크와 함께 정리합니다."
  active="map"
>
  <section>
    <span class="provisional">공개 출처 기반 잠정 데이터 (2026-06-28 재확인) · 관보 대조 후 확정 표기 예정</span><br />
    <span class="eyebrow">선관위 구성 지도</span>
    <h1>중앙선거관리위원 9인은 누가 임명했나</h1>
    <p class="lede">
      중앙선거관리위원회는 대통령 임명 3인, 국회 선출 3인, 대법원장 지명 3인의 9인으로
      구성됩니다 (헌법 제114조). 위원장은 위원 중에서 호선하며 관례상 대법관이 맡아 왔습니다.
    </p>
    <div style="margin-top:18px">
      <CompositionMap appointments={appointments as Appointment[]} />
    </div>
  </section>

  <section>
    <span class="eyebrow">정당 계통 히트맵</span>
    <h2>중앙·시도 162석 — 한눈에 보는 정파 계통</h2>
    <p class="lede" style="font-size:14px; margin-bottom:18px">
      중앙선관위와 17개 시·도선관위를 같은 9열 격자에 놓고 <b>임명·선정 경로의 정파적
      계통</b>으로 색칠했습니다. 국회 선출은 추천 정당, 대통령 임명은 임명한 대통령의
      소속정당을 기준으로 봅니다. 시·도 위원은 공식 위원소개의 선정방법을 그대로
      사용합니다. 위원 개인의 당적을 표시하는 것이 아닙니다.
    </p>
    <PartyHeatmap
      appointments={appointments as Appointment[]}
      lineage={partyLineage as unknown as PartyLineage}
      provincial={provincialCommissioners as ProvincialCommissionersData}
    />
  </section>

  <section>
    <span class="eyebrow">수록 기준</span>
    <p class="lede" style="font-size:14px">
      임명일·임기·경력은 중앙선관위 위원 소개 페이지 기준이며, 사임·직무대행 등 변동 사항은
      공식 발표 또는 복수 매체 교차 확인 시에만 반영합니다. 항목별 출처는 위원 상세에서
      확인할 수 있습니다. 관보 호수 대조 작업이 끝나면 잠정 표기를 제거합니다.
    </p>
  </section>
</Base>
