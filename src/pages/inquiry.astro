---
import Base from '../layouts/Base.astro';
import InquiryStages from '../components/InquiryStages.astro';
import rawInquiry from '../../data/inquiry.json';
import type { Inquiry } from '../lib/types';

const inquiry = rawInquiry as Inquiry;
---

<Base
  title="선관위 국정조사 추적"
  description="중앙선관위 투표용지 부족 사태 국정조사의 절차 단계, 특위 구성, 회의 기록, 증인 명단을 국회 공식 자료 기준으로 추적합니다."
  active="inquiry"
>
  <section>
    <span class="eyebrow">국정조사 추적기</span>
    <h1>{inquiry.name}</h1>
    <p class="lede" style="margin-bottom:16px">
      요구서 제출부터 결과보고서까지, 절차가 어디까지 왔는지를 단계로 표시합니다.
      모든 항목은 국회 공식 자료(의안정보·회의록) 기준으로만 갱신됩니다.
    </p>
    <InquiryStages inquiry={inquiry} />
  </section>

  <section>
    <span class="eyebrow">제출된 국정조사 요구서</span>
    {!inquiry.requests || inquiry.requests.length === 0 ? (
      <div class="empty-note">
        아직 접수된 국정조사 요구서가 없습니다. 의안과 접수 문서 기준으로만 수록합니다.
      </div>
    ) : (
      <>
        <p class="lede" style="font-size:13.5px; margin-bottom:12px">
          여야가 범위가 다른 요구서를 각각 제출했습니다. 각 요구서가 명시한 조사 범위를
          가공 없이 그대로 표시합니다 (어느 쪽이 타당한지는 판단하지 않습니다).
        </p>
        <div class="tl">
          {inquiry.requests.map((req) => (
            <div class="ev">
              <div class="date">{req.date}</div>
              <div class="body">
                <p class="t">{req.title}</p>
                <div class="tags">
                  <span class="badge b-official">{req.party}</span>
                  {req.proposers && <span class="pending-source" style="font-style:normal">{req.proposers}</span>}
                  {req.source.url ? (
                    <span class="ref"><a href={req.source.url} target="_blank" rel="noopener">{req.source.title} ↗</a></span>
                  ) : (
                    <span class="ref pending-source">{req.source.title} (원문 확인 중)</span>
                  )}
                </div>
                {req.scope && req.scope.length > 0 && (
                  <p class="scope">조사 범위: {req.scope.join(' · ')}</p>
                )}
                {req.note && <p class="scope">{req.note}</p>}
              </div>
            </div>
          ))}
        </div>
      </>
    )}
  </section>

  <section>
    <span class="eyebrow">특위 구성</span>
    {inquiry.committee_members.length === 0 ? (
      <div class="empty-note">
        특별위원회가 아직 구성되지 않았습니다. 구성 의결 시 국회 공식 자료 기준으로
        위원 명단과 정당을 게시합니다 (정렬은 가나다순 — 정당 무관 동일 규칙).
      </div>
    ) : (
      <ul>
        {inquiry.committee_members.map((m) => (
          <li>{m.name} ({m.party}){m.role && ` — ${m.role}`}</li>
        ))}
      </ul>
    )}
  </section>

  <section>
    <span class="eyebrow">회의 기록</span>
    {inquiry.hearings.length === 0 ? (
      <div class="empty-note">아직 열린 회의가 없습니다. 회의 일자와 회의록 원문 링크를 게시합니다.</div>
    ) : (
      <div class="tl">
        {inquiry.hearings.map((h) => (
          <div class="ev">
            <div class="date">{h.date}</div>
            <div class="body">
              <p class="t">{h.title}</p>
              <div class="tags">
                {h.source_refs.map((ref) =>
                  ref.url ? (
                    <span class="ref"><a href={ref.url} target="_blank" rel="noopener">{ref.title} ↗</a></span>
                  ) : (
                    <span class="ref pending-source">{ref.title} (원문 공개 대기)</span>
                  )
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <section>
    <span class="eyebrow">증인 · 참고인</span>
    {inquiry.witnesses.length === 0 ? (
      <div class="empty-note">채택된 증인·참고인이 없습니다. 의결 문서 기준으로만 수록합니다.</div>
    ) : (
      <ul>
        {inquiry.witnesses.map((w) => (
          <li>{w.name}{w.note && ` — ${w.note}`}</li>
        ))}
      </ul>
    )}
  </section>

  <section>
    <span class="eyebrow">관련 의안</span>
    {inquiry.related_bills.length === 0 ? (
      <div class="empty-note">국정조사요구서 의안번호 확인 중입니다. 특검법안 등 후속 의안도 여기에 수록됩니다.</div>
    ) : (
      <ul>
        {inquiry.related_bills.map((b) => (
          <li>{b.bill_no} — {b.title}{b.proposer && ` (${b.proposer})`}</li>
        ))}
      </ul>
    )}
  </section>
</Base>
