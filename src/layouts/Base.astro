---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: 'map' | 'timeline' | 'inquiry';
}

const { title, description, active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
const siteUrl = new URL(`${base}/`, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '삼권 threepowers',
  url: siteUrl,
  inLanguage: 'ko',
  description:
    '중앙선거관리위원회·헌법재판소·대법원의 구성과 6·3 사태 기록을 공식 원문 링크와 함께 날짜순으로 기록. 결론을 내리지 않습니다.',
  publisher: {
    '@type': 'Organization',
    name: '삼권 threepowers',
    url: siteUrl,
  },
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 삼권 threepowers</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="삼권 threepowers" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · 삼권 threepowers`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="삼권 threepowers · 6·3 사태 기록" href={`${base}/rss.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="strip">
      <div class="wrap">
        <span>이 서비스는 공식 기록을 날짜순으로 모읍니다. <b>어떤 결론도 내리지 않습니다.</b></span>
      </div>
    </div>

    <header class="mast">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>
          <span class="han">삼권 三權</span>
          <span class="lat">threepowers</span>
        </a>
        <nav class="top">
          <a class:list={[active === 'map' && 'here']} href={`${base}/election-commission/members`}>구성 지도</a>
          <a class:list={[active === 'timeline' && 'here']} href={`${base}/timeline`}>사태 기록</a>
          <a class:list={[active === 'inquiry' && 'here']} href={`${base}/inquiry`}>국정조사</a>
          <a class="rss" href={`${base}/rss.xml`}>RSS</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <p class="foot-line">
          <b>이 서비스는 결론을 내리지 않습니다.</b> 부정선거 여부 등 어떤 판정도 하지 않으며,
          공식 기록(선관위 발표·국회 문서·관보·법령)을 날짜순으로 쌓고 원문 링크를 답니다.
          판정은 진상규명위·국정조사·수사가 합니다.
        </p>
        <p class="foot-line">
          모든 데이터는 관보 · 국회 의안정보 · 선관위 공식 발표에 근거합니다.
          단독 보도·미확인 주장은 싣지 않습니다. 정정 이력은 커밋으로 공개됩니다.
        </p>
        <p class="foot-line">
          이 서비스의 수집 · 요약 · 배포는 <a href="https://github.com/sowonlabs/crewx">CrewX</a> 에이전트가 수행합니다.
        </p>
        <div class="foot-meta">
          <span>코드 MIT · 데이터 CC BY 4.0</span>
          <a href="https://github.com/dohapark81/threepowers">데이터/코드 저장소 ↗</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
